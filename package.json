{
  "name": "csas-hackaton-2024",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "vite --port=3001",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate:routes": "tsr generate",
    "generate:api": "openapi-ts -c @hey-api/client-fetch -i openapi.yaml -o src/lib/client -p @tanstack/react-query",
    "postinstall": "pnpm run generate:routes && pnpm run generate:api"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hey-api/openapi-ts": "0.62.3",
    "@tanstack/router-cli": "1.97.23",
    "@tanstack/router-plugin": "^1.97.23",
    "@types/axios": "0.14.4",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.0.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "openai": "4.80.1",
    "postcss": "^8.5.1",
    "react-icons": "5.4.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "3.0.4"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hey-api/client-fetch": "0.7.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@tanstack/react-query": "^5.64.2",
    "@tanstack/react-router": "^1.97.23",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/router-devtools": "^1.97.23",
    "@types/jest": "^29.5.14",
    "@xyflow/react": "^12.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "kbar": "0.1.0-beta.45",
    "lucide-react": "^0.474.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-day-picker": "9.5.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
